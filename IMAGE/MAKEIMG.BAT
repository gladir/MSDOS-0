@ECHO OFF
REM Reconstruit les images : DOS144A.IMG (+ DOS144B.IMG), DOSCD.ISO et les
REM disquettes d'installation INSTALL.IMG, INSTALL2.IMG...
REM usage : MAKEIMG [dossier_des_commandes]     (defaut : CMDS)
REM Le dossier des commandes contient les .EXE compiles des .PAS de la racine
REM (TPC ou Turbo Pascal 7), dont INSTALL.EXE. Les outils FORMAT, SYS, DISKPC et
REM UNDISKPC et MAKEDISK doivent se trouver dans ..\TOOLS (ou dans le PATH).
SET CMDS=%1
IF "%CMDS%"=="" SET CMDS=CMDS
..\TOOLS\MAKEDISK DOS144A.IMG /FLOPPY:1440 /KERNEL:SYSTEM /CMDS:%CMDS% /TOOLS:..\TOOLS /ISO:DOSCD.ISO
ECHO INSTALL.IMG>INSTALL.RSP
ECHO /NUMBER>>INSTALL.RSP
ECHO /KERNEL:SYSTEM>>INSTALL.RSP
ECHO /CMDS:%CMDS%>>INSTALL.RSP
ECHO /TOOLS:..\TOOLS>>INSTALL.RSP
ECHO /INF:INSTALL.INF>>INSTALL.RSP
ECHO /NOINST:INSTALL.EXE>>INSTALL.RSP
ECHO /BOOT:%CMDS%\INSTALL.EXE>>INSTALL.RSP
ECHO /BOOT:%CMDS%\FORMAT.EXE>>INSTALL.RSP
ECHO /BOOT:%CMDS%\FDISK.EXE>>INSTALL.RSP
ECHO /BOOT:%CMDS%\SYS.EXE>>INSTALL.RSP
ECHO /BOOT:INSTALL\AUTOEXEC.BAT>>INSTALL.RSP
ECHO /BOOT:INSTALL\CONFIG.SYS>>INSTALL.RSP
..\TOOLS\MAKEDISK @INSTALL.RSP
DEL INSTALL.RSP
