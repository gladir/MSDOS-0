Procedure ClearRanges(Var R:TRanges);Begin
 R.N:=0;
End;

Procedure InitOptions;
Var I:Integer;
Begin
 OptMode:=-1; OptSizeSet:=False; OptMinSet:=False;
 OptMaxPool:=0; OptMinPool:=DefMinPool;
 OptFrame:=-1; OptNoFrame:=False;
 OptNoEMS:=False; OptNoVCPI:=False; OptRAM:=False; OptHighScan:=False;
 OptVerbose:=False; OptNoHi:=False; OptNoTR:=False; OptNoMoveXBDA:=False;
 OptAltBoot:=False; OptNoPFC:=False; OptHMAon:=False; OptHelp:=False;
 OptWeitek:=-1; OptLeft:=-1; OptHandles:=0; OptAlt:=-1; OptDMA:=0;
 OptBase:=0;
 For I:=0 to 5 do OptPn[I]:=-1;
 ClearRanges(ExcR); ClearRanges(IncR); ClearRanges(RamR);
 ClearRanges(RomR); ClearRanges(EmsR); ClearRanges(WinR);
 BadParam:='';
End;

  { xxxx-yyyy (segments hexadecimaux) a partir de S[P] }
Function ParseRange(Const S:String;P:Byte;Var R:TRanges):Boolean;
Var F,T:LongInt;
Begin
 ParseRange:=False;
 If R.N>=24 Then Exit;
 If Not GetHex(S,P,F)Then Exit;
 If(F<ConvParas)or(F>$FFFF)Then Exit;
 T:=F;
 If(P<=Length(S))and(S[P]='-')Then Begin
  Inc(P);
  If Not GetHex(S,P,T)Then Exit;
  If(T<F)or(T>$FFFF)Then Exit;
 End;
 If P<=Length(S)Then Exit;
 R.R[R.N].F:=F;
 R.R[R.N].T:=T;
 Inc(R.N);
 ParseRange:=True;
End;

Function SizeOption(V:LongInt):LongInt;
Begin
 If V<MinPool Then Begin V:=MinPool; End Else
 If V>MaxPool Then Begin V:=MaxPool; End
  Else If V and 15<>0 Then V:=V and Not 15;
 SizeOption:=V;
End;

Const
 FrameTab:Array[1..14] of Word=($C000,$C400,$C800,$CC00,$D000,$D400,$D800,$DC00,
                                $E000,$8000,$8400,$8800,$8C00,$9000);

  { Retourne False si le jeton est invalide }
Function ParseToken(T:String):Boolean;
Var P:Byte;V:LongInt;C:Char;Idx:Integer;
Begin
 ParseToken:=False;
 T:=StrToUpper(T);
 If T=''Then Begin ParseToken:=True;Exit;End;
 If T[1]='/'Then Begin
  If T='/?'Then Begin OptHelp:=True;ParseToken:=True;Exit;End;
  If(Length(T)>=3)and(T[2]='P')and(T[3]<>'0')and(T[3]<>'1')and(T[3]<>'2')and(T[3]<>'3')Then Begin
   P:=3;
   If GetHex(T,P,V)and(P>Length(T))and(V>=$8000)and(V<=$FFFF)Then Begin
    OptFrame:=V;ParseToken:=True;
   End;
   Exit;
  End;
  Delete(T,1,1);
  If T=''Then Exit;
 End;
 If T='?'Then Begin OptHelp:=True;ParseToken:=True;Exit;End;
 If T='ON'Then Begin
  If OptMode<>-1 Then Exit;
  OptMode:=0;ParseToken:=True;Exit;
 End;
 If T='OFF'Then Begin
  If OptMode<>-1 Then Exit;
  OptMode:=1;ParseToken:=True;Exit;
 End;
 If T='AUTO'Then Begin
  If OptMode<>-1 Then Exit;
  OptMode:=2;ParseToken:=True;Exit;
 End;
 C:=T[1];
 Case C of
  '0'..'9':Begin
   If OptSizeSet Then Exit;
   P:=1;
   If Not GetDec(T,P,V)Then Exit;
   If P<=Length(T)Then Exit;
   OptMaxPool:=SizeOption(V);
   OptSizeSet:=True;
   ParseToken:=True;
  End;
  'M':Begin
   If Copy(T,1,4)='MIN='Then Begin
    If OptMinSet Then Exit;
    P:=5;
    If Not GetDec(T,P,V)Then Exit;
    If P<=Length(T)Then Exit;
    If V>MaxPool Then V:=MaxPool;
    V:=V and Not 15;
    OptMinPool:=V;OptMinSet:=True;
    ParseToken:=True;
   End
    Else
   Begin
    If OptFrame<>-1 Then Exit;
    P:=2;
    If Not GetDec(T,P,V)Then Exit;
    If(P<=Length(T))or(V<1)or(V>14)Then Exit;
    OptFrame:=FrameTab[V];
    ParseToken:=True;
   End;
  End;
  'F':Begin
   If Copy(T,1,6)<>'FRAME='Then Exit;
   If OptFrame<>-1 Then Exit;
   If Copy(T,7,255)='NONE'Then Begin
    OptNoFrame:=True;ParseToken:=True;Exit;
   End;
   P:=7;
   If Not GetHex(T,P,V)Then Exit;
   If(P<=Length(T))or(V<$8000)or(V>$FFFF)Then Exit;
   OptFrame:=V;ParseToken:=True;
  End;
  'P':Begin
   P:=2;
   If Not GetDec(T,P,V)Then Exit;
   If(V>3)and(V<254)Then Exit;
   If V>=254 Then V:=V-250;
   Idx:=V;
   If(P>Length(T))or(T[P]<>'=')Then Exit;
   If OptPn[Idx]<>-1 Then Exit;
   Inc(P);
   If Not GetHex(T,P,V)Then Exit;
   If(P<=Length(T))or(V>$FFFF)Then Exit;
   OptPn[Idx]:=V;
   ParseToken:=True;
  End;
  'B':Begin
   If Copy(T,1,2)<>'B='Then Exit;
   P:=3;
   If Not GetHex(T,P,V)Then Exit;
   If(P<=Length(T))or(V<$1000)Then Exit;
   OptBase:=V;ParseToken:=True;
  End;
  'D':Begin
   If T='DMAXT'Then Begin ParseToken:=True;Exit;End;
   If Copy(T,1,2)<>'D='Then Exit;
   P:=3;
   If Not GetDec(T,P,V)Then Exit;
   If(P<=Length(T))or(V<16)or(V>256)Then Exit;
   OptDMA:=V;ParseToken:=True;
  End;
  'L':Begin
   If Copy(T,1,2)<>'L='Then Exit;
   If OptLeft<>-1 Then Exit;
   P:=3;
   If Not GetDec(T,P,V)Then Exit;
   If(P<=Length(T))or(V<1)Then Exit;
   OptLeft:=V;ParseToken:=True;
  End;
  'A':Begin
   If T='ALTBOOT'Then Begin OptAltBoot:=True;ParseToken:=True;Exit;End;
   If Copy(T,1,2)<>'A='Then Exit;
   P:=3;
   If Not GetDec(T,P,V)Then Exit;
   If(P<=Length(T))or(V>254)Then Exit;
   OptAlt:=V;ParseToken:=True;
  End;
  'H':Begin
   If T='HIGHSCAN'Then Begin OptHighScan:=True;ParseToken:=True;Exit;End;
   If Copy(T,1,5)='HMAON'Then Begin
    OptHMAon:=True;
    If(Length(T)>5)Then Begin
     If T[6]<>'='Then Exit;
     P:=7;
     If Not GetDec(T,P,V)Then Exit;
     If(P<=Length(T))or(V>63)Then Exit;
    End;
    ParseToken:=True;Exit;
   End;
   If Copy(T,1,2)<>'H='Then Exit;
   P:=3;
   If Not GetDec(T,P,V)Then Exit;
   If(P<=Length(T))or(V<2)or(V>255)Then Exit;
   OptHandles:=V;ParseToken:=True;
  End;
  'W':Begin
   If T='W=ON'Then Begin OptWeitek:=1;ParseToken:=True;Exit;End;
   If T='W=OFF'Then Begin OptWeitek:=0;ParseToken:=True;Exit;End;
   If Copy(T,1,4)='WIN='Then ParseToken:=ParseRange(T,5,WinR);
  End;
  'X':Begin
   If Copy(T,1,2)='X='Then ParseToken:=ParseRange(T,3,ExcR);
  End;
  'I':Begin
   If Copy(T,1,2)='I='Then ParseToken:=ParseRange(T,3,IncR);
  End;
  'E':Begin
   If T='EMSINTS'Then Begin ParseToken:=True;Exit;End;
   If Copy(T,1,4)='EMS='Then ParseToken:=ParseRange(T,5,EmsR);
  End;
  'R':Begin
   If T='RAM'Then Begin OptRAM:=True;ParseToken:=True;Exit;End;
   If Copy(T,1,4)='RAM='Then Begin ParseToken:=ParseRange(T,5,RamR);Exit;End;
   If(T='ROM')or(T='ROMCOMPRESS')Then Begin ParseToken:=True;Exit;End;
   If Copy(T,1,4)='ROM='Then ParseToken:=ParseRange(T,5,RomR);
  End;
  'N':Begin
   If T='NOEMS'Then Begin OptNoEMS:=True;ParseToken:=True;Exit;End;
   If T='NOVCPI'Then Begin OptNoVCPI:=True;ParseToken:=True;Exit;End;
   If T='NOHI'Then Begin OptNoHi:=True;ParseToken:=True;Exit;End;
   If T='NOTR'Then Begin OptNoTR:=True;ParseToken:=True;Exit;End;
   If T='NOMOVEXBDA'Then Begin OptNoMoveXBDA:=True;ParseToken:=True;Exit;End;
   If T='NOPFC'Then Begin OptNoPFC:=True;ParseToken:=True;Exit;End;
   If(T='NOINT')or(T='NOA20TRAP')or(T='NOLOCUMBS')Then ParseToken:=True;
  End;
  'V':Begin
   If T='VIR8042'Then Begin ParseToken:=True;Exit;End;
   If Copy('VERBOSE',1,Length(T))=T Then Begin
    OptVerbose:=True;ParseToken:=True;
   End;
  End;
  'Y':Begin
   If Copy(T,1,2)='Y='Then ParseToken:=True;
  End;
 End;
End;

  { Decoupe une chaine en jetons (espace, tabulation, virgule, point-virgule) }
Function ParseLine(S:String):Boolean;
Var I:Byte;Tok:String;
Begin
 ParseLine:=True;
 Tok:='';
 For I:=1 to Length(S)+1 do Begin
  If(I>Length(S))or(S[I]in[' ',#9,',',';'])Then Begin
   If Tok<>''Then Begin
    If Not ParseToken(Tok)Then Begin
     BadParam:=Tok;
     ParseLine:=False;
     Exit;
    End;
    Tok:='';
   End;
  End
   Else
  Tok:=Tok+S[I];
 End;
End;

Function ParseCommandLine:Boolean;
Var I:Integer;
Begin
 ParseCommandLine:=True;
 For I:=1 to ParamCount do
  If Not ParseLine(ParamStr(I))Then Begin
   ParseCommandLine:=False;
   Exit;
  End;
End;

 { ------------------------------------------------------------------ memoire haute }

Procedure MarkPages(F,T:Word;Value:Byte;Inward:Boolean);
Var A,B:LongInt;I:LongInt;
Begin
 If Inward Then Begin
  A:=(LongInt(F)+255) shr 8;
  B:=((LongInt(T)+1) shr 8)-1;
 End
  Else
 Begin
  A:=F shr 8;
  B:=T shr 8;
 End;
 If A<0 Then A:=0;
 If B>255 Then B:=255;
 For I:=A to B do PgUse[I]:=Value;
End;

Function PageUniform(P:Word):Boolean;
Var I:Word;V:Byte;
Begin
 V:=Mem[P shl 8:0];
 PageUniform:=False;
 If(V<>$FF)and(V<>0)Then Exit;
 For I:=1 to 4095 do
  If Mem[P shl 8:I]<>V Then Exit;
 PageUniform:=True;
End;

Procedure ScanUpperMemory;
Var Seg,Len:Word;I:Integer;
Begin
 FillChar(PgUse,SizeOf(PgUse),0);
  { video, ROM systeme }
 MarkPages($A000,$BFFF,1,False);
 MarkPages($F000,$FFFF,1,False);
  { zone d'adaptateur VGA/EGA (C000h-C7FFh) : reservee par prudence, meme
    sans signature 55AAh detectee (certains BIOS/emulateurs y reservent de
    l'espace au-dela de la ROM declaree). Un I=/RAM= explicite peut la
    reclamer malgre tout (applique plus loin, apres ce marquage). }
 MarkPages($C000,$C7FF,1,False);
  { en-tetes de ROM (55AAh) }
 Seg:=$C000;
 While Seg<$F000 do Begin
  If MemW[Seg:0]=$AA55 Then Begin
   Len:=Mem[Seg:2];
   If Len=0 Then Len:=1;
   Len:=(Len*512+15) shr 4;
   Len:=(Len+127) and Not 127;
   If LongInt(Seg)+Len>$F000 Then Len:=$F000-Seg;
   MarkPages(Seg,Seg+Len-1,1,False);
   Inc(Seg,Len);
  End
   Else
  Inc(Seg,$80);
 End;
 If OptHighScan Then
  For I:=$C0 to $EF do
   If PgUse[I]=0 Then
    If Not PageUniform(I)Then PgUse[I]:=1;
 For I:=0 to RomR.N-1 do MarkPages(RomR.R[I].F,RomR.R[I].T,1,False);
 For I:=0 to ExcR.N-1 do MarkPages(ExcR.R[I].F,ExcR.R[I].T,1,False);
 For I:=0 to WinR.N-1 do MarkPages(WinR.R[I].F,WinR.R[I].T,1,False);
 For I:=0 to IncR.N-1 do MarkPages(IncR.R[I].F,IncR.R[I].T,2,True);
 For I:=0 to RamR.N-1 do MarkPages(RamR.R[I].F,RamR.R[I].T,2,True);
 For I:=0 to EmsR.N-1 do MarkPages(EmsR.R[I].F,EmsR.R[I].T,2,True);
End;

Function WindowFree(StartPage:Integer):Boolean;
Var I:Integer;
Begin
 WindowFree:=False;
 If(StartPage<$C0)or(StartPage+15>$EF)Then Exit;
 For I:=StartPage to StartPage+15 do
  If PgUse[I]=1 Then Exit;
 WindowFree:=True;
End;

  { Choix du segment du cadre de pages ; 0 si aucun }
Function FindFrame:Word;
Const Pref:Array[0..8] of Integer=($E0,$D0,$C0,$EC,$E8,$E4,$DC,$D8,$D4);
Var I,P:Integer;
Begin
 FindFrame:=0;
 For I:=0 to 8 do
  If WindowFree(Pref[I])Then Begin
   FindFrame:=Pref[I] shl 8;
   Exit;
  End;
 P:=$EC;
 While P>=$C0 do Begin
  If WindowFree(P)Then Begin
   FindFrame:=P shl 8;
   Exit;
  End;
  Dec(P,4);
 End;
End;

Function FrameOverlapsUsed(Seg:Word):Boolean;
Var I:Integer;
Begin
 FrameOverlapsUsed:=False;
 If Seg<$C000 Then Exit;
 For I:=Seg shr 8 to(Seg shr 8)+15 do
  If(I<=255)and(PgUse[I]=1)Then FrameOverlapsUsed:=True;
End;

  { Regions de memoire haute disponibles pour les UMB (hors cadre de pages) }
Procedure BuildUmbRegions;
Var I:Integer;Run:Integer;First:Integer;
Procedure Flush(EndPage:Integer);Begin
 If(Run>0)and(NUmb<16)Then Begin
  UmbTab[NUmb].Seg:=First shl 8;
  UmbTab[NUmb].Paras:=Run shl 8;
  Inc(NUmb);
  Inc(UmbTotalParas,LongInt(Run) shl 8);
 End;
 Run:=0;
End;
Begin
 NUmb:=0;
 UmbTotalParas:=0;
 Run:=0;
 First:=0;
 For I:=$C0 to $EF do Begin
  If(PgUse[I]<>1)and Not((FrameSeg<>0)and(I>=FrameSeg shr 8)and(I<(FrameSeg shr 8)+16))Then Begin
   If Run=0 Then First:=I;
   Inc(Run);
  End
   Else
  Flush(I);
 End;
 Flush(256);
End;

 { ------------------------------------------------------------------ disposition du bloc XMS }

Type
 TLay=Record
  HndOff,AltOff,AltSize,DummyOff,WinPtOff,FreeOff,HeapOff,HeapSize:LongInt;
  UmbOff,UmbPages,PoolOff,PoolPages,PtOff,NPt,Total:LongInt;
 End;

Var
 Lay:TLay;

Function Align4K(V:LongInt):LongInt;Begin
 Align4K:=(V+4095) and Not LongInt(4095);
End;

Procedure ComputeLayout(PoolKBytes:LongInt);
Var Off,T:LongInt;I:Integer;N:LongInt;
Begin
 FillChar(Lay,SizeOf(Lay),0);
 Lay.PoolPages:=PoolKBytes div 4;
 Off:=BLK_MON+Align4K(MonImageLen);
 Lay.HndOff:=Off;
 Inc(Off,Align4K(LongInt(NHandles)*32));
 Lay.AltOff:=Off;
 Lay.AltSize:=(LongInt(NHandles)+NAlt+1)*16;
 Inc(Off,Align4K(Lay.AltSize));
 Lay.DummyOff:=Off;Inc(Off,4096);
 Lay.WinPtOff:=Off;Inc(Off,4096);
 Lay.FreeOff:=Off;
 Inc(Off,Align4K(Lay.PoolPages*4+4));
 Lay.HeapOff:=Off;
 Lay.HeapSize:=Align4K((Lay.PoolPages div 4)*16*2+1024);
 If Lay.HeapSize<4096 Then Lay.HeapSize:=4096;
 Inc(Off,Lay.HeapSize);
 Lay.UmbPages:=0;
 For I:=0 to NUmb-1 do Inc(Lay.UmbPages,UmbTab[I].Paras shr 8);
 Lay.UmbOff:=Off;
 Inc(Off,Lay.UmbPages*4096);
 Lay.PoolOff:=Off;
 Inc(Off,Lay.PoolPages*4096);
 Lay.PtOff:=Off;
  { tables de pages supplementaires : une par tranche de 4 Mo au-dela de la premiere }
 Lay.NPt:=1;
 Repeat
  T:=Off+(Lay.NPt-1)*4096;
  N:=(LongInt($110000)+T+$3FFFFF) div $400000;
  If N<1 Then N:=1;
  If N=Lay.NPt Then Break;
  Lay.NPt:=N;
 Until False;
 Lay.Total:=Off+(Lay.NPt-1)*4096;
End;

  { Choix de la taille du reservoir : retourne False si la memoire est insuffisante }
Function ChooseSize(AvailKB:LongInt):Boolean;
Var Want,Pool:LongInt;
Begin
 ChooseSize:=False;
 If Not(EMSOn or VCPIOn)Then Begin
  PoolKB:=0;
  ComputeLayout(0);
  ChooseSize:=(Lay.Total div 1024)+4<=AvailKB;
  Exit;
 End;
 If OptLeft>0 Then Dec(AvailKB,OptLeft);
 If OptSizeSet Then Want:=OptMaxPool Else Want:=MaxPool;
 Pool:=Want and Not 15;
 Repeat
  ComputeLayout(Pool);
  If(Lay.Total div 1024)+4<=AvailKB Then Break;
  If Pool<=0 Then Exit;
  Dec(Pool,16);
 Until False;
 If Pool<Want Then Begin
  If OptSizeSet Then WriteLn(Msg(M_ADJ));
 End;
 If(Pool<OptMinPool)and EMSOn Then Begin
  If Pool<MinPool Then Exit;
  WriteLn(Msg(M_ADJ));
 End;
 PoolKB:=Pool;
 ChooseSize:=True;
End;

 { ------------------------------------------------------------------ installation }

Function FindInstalled:Word;
Const Sig:String[6]='EMM386';
Var S:Word;I:Byte;Ok:Boolean;
Begin
 FindInstalled:=0;
 S:=MemW[0:$67*4+2];
 If S=0 Then Exit;
 Ok:=True;
 For I:=1 to 6 do
  If Mem[S:$11+I]<>Ord(Sig[I])Then Ok:=False;
 If Ok Then FindInstalled:=S;
End;

  { Un autre gestionnaire d'EMS (nom EMMXXXX0 ou EMMQXXX0) est-il present ? }
Function OtherEMM:Boolean;
Var S:Word;I:Byte;N:String[8];
Begin
 OtherEMM:=False;
 S:=MemW[0:$67*4+2];
 If S=0 Then Exit;
 N:='';
 For I:=0 to 7 do N:=N+Chr(Mem[S:$0A+I]);
 If(N='EMMXXXX0')or(N='EMMQXXX0')Then OtherEMM:=True;
End;

Procedure FreeResources;
Begin
 If XHandle<>0 Then Begin
  XR.AX:=$0D00;XR.DX:=XHandle;XMSCall(XR);
  XR.AX:=$0A00;XR.DX:=XHandle;XMSCall(XR);
  XHandle:=0;
 End;
 If RMSeg<>0 Then Begin
  Regs.AH:=$49;Regs.ES:=RMSeg;MsDos(Regs);
  RMSeg:=0;
 End;
End;

Procedure Fail(S:String);
Begin
 WriteLn(S);
 FreeResources;
 Halt(1);
End;

Procedure BuildTables;
Var I,T:LongInt;K,L,Shift:LongInt;
Begin
 Shift:=BBase-XPhys;
 FillChar(Pg,SizeOf(Pg),0);
 Pg[0]:=(BBase+BLK_PT0)or 7;
 For T:=1 to Lay.NPt-1 do Pg[T]:=(BBase+Lay.PtOff+(T-1)*4096)or 7;
 XMove(Pg,4096,XHandle,Shift+BLK_PD);
 FillChar(Pg,SizeOf(Pg),0);
 For I:=0 to 1023 do Begin
  If I<$110 Then Pg[I]:=(I shl 12)or 7
  Else Begin
   K:=(I-$110)*4096;
   If K<Lay.Total Then Pg[I]:=(BBase+K)or 7;
  End;
 End;
 XMove(Pg,4096,XHandle,Shift+BLK_PT0);
 For T:=1 to Lay.NPt-1 do Begin
  FillChar(Pg,SizeOf(Pg),0);
  For I:=0 to 1023 do Begin
   L:=T*4194304+I*4096;
   If L>=$110000 Then Begin
    K:=L-$110000;
    If K<Lay.Total Then Pg[I]:=(BBase+K)or 7;
   End;
  End;
  XMove(Pg,4096,XHandle,Shift+Lay.PtOff+(T-1)*4096);
 End;
End;

Procedure BuildMonitor;
Var Shift:LongInt;I:Integer;
Begin
 Shift:=BBase-XPhys;
 XZero(Shift+BLK_MON,Align4K(MonImageLen));
 XPut(MonGdtData,SizeOf(MonGdtData),Shift+BLK_MON+$200);
 XPut(MonIdtData,SizeOf(MonIdtData),Shift+BLK_MON+$280);
 XPut(MonTssData,SizeOf(MonTssData),Shift+BLK_MON+$480);
 XPut(MonCodeData,SizeOf(MonCodeData),Shift+BLK_MON+$1600);
 FillChar(Cfg,SizeOf(Cfg),0);
 Cfg.Sig:=$38334D45;
 Cfg.RmSeg:=RMSeg;
 If EMSOn Then Cfg.Flags:=Cfg.Flags or CF_EMS;
 If UMBOn Then Cfg.Flags:=Cfg.Flags or CF_UMB;
 If VCPIOn Then Cfg.Flags:=Cfg.Flags or CF_VCPI;
 If OptNoEMS Then Cfg.Flags:=Cfg.Flags or CF_NOEMS;
 If OptVerbose Then Cfg.Flags:=Cfg.Flags or CF_VERBOSE;
 Cfg.BlkPhys:=BBase;
 Cfg.BlkSize:=Lay.Total;
 Cfg.FrameSeg:=FrameSeg;
 Cfg.NHandles:=NHandles;
 Cfg.PoolOff:=Lay.PoolOff;
 Cfg.PoolPages:=Lay.PoolPages;
 Cfg.HndOff:=Lay.HndOff;
 Cfg.FreeOff:=Lay.FreeOff;
 Cfg.HeapOff:=Lay.HeapOff;
 Cfg.HeapSize:=Lay.HeapSize;
 Cfg.AltOff:=Lay.AltOff;
 Cfg.AltSize:=Lay.AltSize;
 Cfg.NAltSets:=NAlt;
 If A20Was Then Cfg.A20Init:=1;
 Cfg.UmbOff:=Lay.UmbOff;
 Cfg.UmbPages:=Lay.UmbPages;
 Cfg.NUmb:=NUmb;
 For I:=0 to NUmb-1 do Cfg.UmbTab[I]:=UmbTab[I];
 Cfg.DummyOff:=Lay.DummyOff;
 Cfg.WinPtOff:=Lay.WinPtOff;
 XMove(Cfg,512,XHandle,Shift+BLK_MON);
End;

Procedure BuildResident;
Const OwnerName:String[6]='EMM386';
Var I:Integer;Pfx:String;
Begin
 Regs.AH:=$48;Regs.BX:=RM_PARAS;
 MsDos(Regs);
 If(Regs.Flags and 1)<>0 Then Begin
  RMSeg:=0;
  Fail(Msg(M_RMBLK));
 End;
 RMSeg:=Regs.AX;
 FillChar(Mem[RMSeg:0],RM_PARAS*16,0);
 Move(RMData,Mem[RMSeg:0],RMLen);
 For I:=1 to 8 do Mem[RMSeg:$0A+I-1]:=Ord(DevName[I]);
 MemL[RMSeg:RD_CR3]:=BBase;
 MemW[RMSeg:RD_SEG]:=RMSeg;
 MemW[RMSeg-1:1]:=RMSeg;
 For I:=0 to 7 do Mem[RMSeg-1:8+I]:=0;
 For I:=1 to 6 do Mem[RMSeg-1:8+I-1]:=Ord(OwnerName[I]);
 Pfx:=Msg(M_PRIV);
 If Length(Pfx)>60 Then Pfx[0]:=Chr(60);
 For I:=1 to Length(Pfx)do Mem[RMSeg:RD_ERRPFX+I-1]:=Ord(Pfx[I]);
 Mem[RMSeg:RD_ERRPFX+Length(Pfx)]:=0;
End;

  { Chaine l'en-tete de peripherique EMMXXXX0 apres le peripherique NUL }
Procedure LinkDevice;
Var NS,NO:Word;
Begin
 Regs.AH:=$52;
 MsDos(Regs);
 NS:=Regs.ES;
 NO:=Regs.BX+$22;
 MemL[RMSeg:0]:=MemL[NS:NO];
 MemW[NS:NO]:=0;
 MemW[NS:NO+2]:=RMSeg;
End;

 { ------------------------------------------------------------------ etat/commande }

  { Appelle la fonction de controle DAh du moniteur (deja charge) }
Procedure CtlCall(Var R:Registers);Begin
 Intr($67,R);
End;

Procedure ShowStatus;
Var R:Registers;Flags,NH:Word;
Begin
 If FindInstalled=0 Then Begin
  WriteLn(Msg(M_NOTINST));
  Exit;
 End;
 R.AH:=$DA;R.AL:=0;
 CtlCall(R);
 If R.AX<>$DA55 Then Begin
  WriteLn(Msg(M_NOTINST));
  Exit;
 End;
 Flags:=R.BX;
 WriteLn(Msg(M_BANNER));
 WriteLn;
 If(Flags and CF_ACTIVE)<>0 Then WriteLn(Msg(M_ACTIVE))Else WriteLn(Msg(M_INACTIVE));
 If(Flags and CF_EMS)<>0 Then Begin
  WriteLn(DotLine(Msg(M_AVAILEMS),DecStr(LongInt(R.CX)*16)+Msg(M_KB)));
  WriteLn(DotLine(Msg(M_TOTPAGES),DecStr(R.DX)));
  WriteLn(DotLine(Msg(M_AVPAGES),DecStr(R.CX)));
  WriteLn(DotLine(Msg(M_TOTHND),DecStr(R.DI)));
  If R.SI<>0 Then WriteLn(DotLine(Msg(M_FRAME),HexStr(R.SI,4)+'h'))
             Else WriteLn(DotLine(Msg(M_FRAME),Msg(M_NOFRAME)));
 End;
 If(Flags and CF_VCPI)<>0 Then WriteLn(Msg(M_VCPION));
 R.AH:=$DA;R.AL:=1;
 CtlCall(R);
 If R.AX=$DA55 Then Begin
  If R.BX=0 Then WriteLn(Msg(M_NOUMB))
  Else Begin
   WriteLn(DotLine(Msg(M_UMBTOT),DecStr(LongInt(R.BX) div 64)+Msg(M_KB)));
   WriteLn(DotLine(Msg(M_UMBBIG),DecStr(LongInt(R.CX) div 64)+Msg(M_KB)));
   WriteLn(DotLine(Msg(M_FIRSTUMB),HexStr(R.DX,4)+'h'));
  End;
 End;
End;

Procedure SetMode(M:Byte);
Var R:Registers;
Begin
 If FindInstalled=0 Then Begin
  WriteLn(Msg(M_NOTINST));
  Halt(1);
 End;
 R.AH:=$DA;R.AL:=2;R.BL:=M;
 CtlCall(R);
 If R.AX<>$DA55 Then Begin
  Case M of
   0:WriteLn(Msg(M_ERRON));
   1:WriteLn(Msg(M_ERROFF));
   Else WriteLn(Msg(M_ERRAUTO));
  End;
  WriteLn(Msg(M_OFFUNSUP));
  Halt(1);
 End;
 Case M of
  0:WriteLn(Msg(M_ACTIVE));
  1:WriteLn(Msg(M_INACTIVE));
  Else WriteLn(Msg(M_AUTO));
 End;
End;

 { ------------------------------------------------------------------ installation (suite) }

Procedure HookVectors;
Var OldV:Pointer;
Begin
 GetIntVec($15,OldV);
 MemL[RMSeg:RD_OLD15]:=LongInt(OldV);
 SetIntVec($15,Ptr(RMSeg,RMI15Ofs));
 If(Mem[Seg(XMSEntry^):Ofs(XMSEntry^)]=$EB)Then
  MemL[RMSeg:RD_XMSNEXT]:=LongInt(Ptr(Seg(XMSEntry^),Ofs(XMSEntry^)+5))
 Else
  MemL[RMSeg:RD_XMSNEXT]:=LongInt(XMSEntry);
 Mem[Seg(XMSEntry^):Ofs(XMSEntry^)]:=$EA;
 MemW[Seg(XMSEntry^):Ofs(XMSEntry^)+1]:=RMXmsOfs;
 MemW[Seg(XMSEntry^):Ofs(XMSEntry^)+3]:=RMSeg;
 SetIntVec($67,Ptr(RMSeg,RMEmsOfs));
End;

Function KBNeeded:LongInt;Begin
 KBNeeded:=((Lay.Total+1023)div 1024)+4;
End;

Procedure Install;
Var AvailKB:LongInt;I:Integer;
Begin
 If Not Is386 Then Begin WriteLn(Msg(M_NEED386));Halt(1);End;
 If IsV86 Then Begin WriteLn(Msg(M_INV86));Halt(1);End;
 If FindInstalled<>0 Then Begin WriteLn(Msg(M_ALREADY));Halt(1);End;
 If OtherEMM Then Begin WriteLn(Msg(M_OTHEREMM));Halt(1);End;
 If OptMode=1 Then Begin WriteLn(Msg(M_OFFUNSUP));Halt(1);End;
 Regs.AX:=$4300;Intr($2F,Regs);
 If Regs.AL<>$80 Then Begin WriteLn(Msg(M_NOXMS));Halt(1);End;
 Regs.AX:=$4310;Intr($2F,Regs);
 XMSEntry:=Ptr(Regs.ES,Regs.BX);
 XHandle:=0;RMSeg:=0;
 If OptNoEMS Then Begin
  EMSOn:=False;
  VCPIOn:=Not OptNoVCPI;
  UMBOn:=True;
  DevName:='EMMQXXX0';
 End
  Else
 Begin
  EMSOn:=True;
  VCPIOn:=Not OptNoVCPI;
  UMBOn:=OptRAM or OptHMAon or OptNoFrame;
  DevName:='EMMXXXX0';
 End;
 ScanUpperMemory;
 FrameSeg:=0;
 If EMSOn and Not OptNoFrame Then Begin
  If OptFrame<>-1 Then Begin
   FrameSeg:=OptFrame;
   If FrameOverlapsUsed(FrameSeg)Then WriteLn(Msg(M_FRAMEROM));
  End
   Else
  Begin
   FrameSeg:=FindFrame;
   If FrameSeg=0 Then Begin
    WriteLn(Msg(M_NOPF));
    EMSOn:=False;
    UMBOn:=True;
   End;
  End;
 End;
 If UMBOn Then BuildUmbRegions Else Begin NUmb:=0;UmbTotalParas:=0;End;
 If OptHandles>0 Then NHandles:=OptHandles
 Else If(Not EMSOn)and(Not VCPIOn)Then NHandles:=2
 Else NHandles:=MaxHandlesDef;
 If NHandles<2 Then NHandles:=2;
 If OptAlt>=0 Then NAlt:=OptAlt
 Else If(Not EMSOn)and(Not VCPIOn)Then NAlt:=0
 Else NAlt:=MaxAltDef;
 XR.AX:=$0800;XMSCall(XR);
 AvailKB:=XR.DX;
 If AvailKB=0 Then AvailKB:=XR.AX;
 If Not ChooseSize(AvailKB)Then Fail(Msg(M_NOMEM));
 XR.AX:=$0900;XR.DX:=KBNeeded;XMSCall(XR);
 If XR.AX<>1 Then Fail(Msg(M_NOMEM));
 XHandle:=XR.DX;
 XR.AX:=$0C00;XR.DX:=XHandle;XMSCall(XR);
 XPhys:=LongInt(XR.DX)shl 16+XR.BX;
 BBase:=(XPhys+4095)and Not LongInt(4095);
 XR.AX:=$0700;XMSCall(XR);
 A20Was:=(XR.AX and 1)<>0;
  BuildTables;
 BuildResident;
 BuildMonitor;
 HookVectors;
 LinkDevice;
 EnterPtr:=Ptr(RMSeg,RMEnterOfs);
 CallEnter;
 Regs.AH:=$DA;Regs.AL:=0;
 Intr($67,Regs);
 If Regs.AX<>$DA55 Then Fail(Msg(M_NOTV86));
 EMSOn:=(Regs.BX and CF_EMS)<>0;
 VCPIOn:=(Regs.BX and CF_VCPI)<>0;
End;

 { ------------------------------------------------------------------ resume post-installation }

Procedure ShowSummary;
Var I:Integer;Biggest:LongInt;
Begin
 WriteLn(Msg(M_BANNER));
 WriteLn;
 WriteLn(Msg(M_INSTALLED));
 If EMSOn Then Begin
  WriteLn(DotLine(Msg(M_AVAILEMS),DecStr(PoolKB)+Msg(M_KB)));
  If FrameSeg<>0 Then WriteLn(DotLine(Msg(M_FRAME),HexStr(FrameSeg,4)+'h'))
                 Else WriteLn(DotLine(Msg(M_FRAME),Msg(M_NOFRAME)));
 End;
 If VCPIOn Then WriteLn(Msg(M_VCPION));
 If UMBOn Then Begin
  If NUmb=0 Then WriteLn(Msg(M_NOUMB))
  Else Begin
   WriteLn(DotLine(Msg(M_UMBTOT),DecStr(UmbTotalParas div 64)+Msg(M_KB)));
   Biggest:=0;
   For I:=0 to NUmb-1 do If UmbTab[I].Paras>Biggest Then Biggest:=UmbTab[I].Paras;
   WriteLn(DotLine(Msg(M_UMBBIG),DecStr(Biggest div 64)+Msg(M_KB)));
   WriteLn(Msg(M_UMBNOTE));
  End;
 End;
End;

Procedure ShowUsage;Begin
 WriteLn(Msg(M_BANNER));
 WriteLn;
 WriteLn(Msg(M_USAGE));
 WriteLn(Msg(M_USAGE1));
 WriteLn(Msg(M_USAGE2));
 WriteLn(Msg(M_USAGE3));
End;

 { ------------------------------------------------------------------ programme principal }

Procedure InitConvParas;
Var R:Registers;
Begin
 Intr($12,R);
 ConvParas:=LongInt(R.AX)*64;
End;

BEGIN
 Language:=_French;
 TmpLanguage:=GetEnv('LANGUAGE');
 If TmpLanguage<>''Then Begin
  If TmpLanguage[1]='"'Then TmpLanguage:=Copy(TmpLanguage,2,255);
  If StrToUpper(Copy(TmpLanguage,1,2))='EN'Then Language:=_English Else
  If StrToUpper(Copy(TmpLanguage,1,2))='GR'Then Language:=_Germany;
 End;
 InitConvParas;
 InitOptions;
 If Not ParseCommandLine Then Begin
  WriteLn(Msg(M_INVPARM),BadParam);
  Halt(1);
 End;
 If OptHelp Then Begin ShowUsage;Halt(0);End;
 If FindInstalled<>0 Then Begin
  Case OptMode of
   0:SetMode(0);
   1:SetMode(1);
   2:SetMode(2);
   Else ShowStatus;
  End;
  Halt(0);
 End;
 If OptMode=-1 Then OptMode:=0;
 Install;
 ShowSummary;
END.
