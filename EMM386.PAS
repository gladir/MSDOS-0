 { ------------------------------------------------------------------ utilitaires }

Function StrToUpper(S:String):String;
Var I:Byte;
Begin
 For I:=1 to Length(S)do Begin
  If S[I] in['a'..'z']Then S[I]:=Chr(Ord(S[I])-32);
 End;
 StrToUpper:=S;
End;

Function HexStr(V:LongInt;N:Byte):String;
Var S:String;I:Byte;
Begin
 S:='';
 For I:=N-1 downto 0 do S:=S+Hexa[((V shr (I*4)) and 15)+1];
 HexStr:=S;
End;

Function DecStr(V:LongInt):String;
Var S:String;
Begin
 Str(V,S);
 DecStr:=S;
End;

Function DotLine(Name,Value:String):String;
Var S:String;
Begin
 S:=Name+' ';
 While Length(S)<42 do S:=S+'.';
 DotLine:=S+' '+Value;
End;

  { Lit un nombre decimal a partir de S[P] ; retourne False si aucun chiffre }
Function GetDec(Const S:String;Var P:Byte;Var V:LongInt):Boolean;
Var Start:Byte;
Begin
 V:=0;
 Start:=P;
 While(P<=Length(S))and(S[P]in['0'..'9'])do Begin
  If V>200000000 Then V:=200000000 Else V:=V*10+Ord(S[P])-48;
  Inc(P);
 End;
 GetDec:=P>Start;
End;

Function GetHex(Const S:String;Var P:Byte;Var V:LongInt):Boolean;
Var Start:Byte;C:Char;
Begin
 V:=0;
 Start:=P;
 While P<=Length(S)do Begin
  C:=UpCase(S[P]);
  If C in['0'..'9']Then V:=(V shl 4)+Ord(C)-48 Else
  If C in['A'..'F']Then V:=(V shl 4)+Ord(C)-55
                   Else Break;
  If V>$FFFFFF Then V:=$FFFFFF;
  Inc(P);
 End;
 GetHex:=P>Start;
End;

 { ------------------------------------------------------------------ bas niveau }

Function Is386:Boolean;Assembler;
ASM
 pushf
 pop dx
 mov bx,dx
 and bx,0FFFh
 push bx
 popf
 pushf
 pop ax
 and ax,0F000h
 cmp ax,0F000h
 je @no
 or bx,0F000h
 push bx
 popf
 pushf
 pop ax
 and ax,0F000h
 jz @no
 mov al,1
 jmp @fin
@no:
 xor al,al
@fin:
 push dx
 popf
End;

Function IsV86:Boolean;Assembler;
ASM
 db $0F,$01,$E0
 and al,1
End;

Procedure XMSCall(Var X:XRegs);Assembler;
ASM
 push ds
 push bp
 lds si,X
 push ds
 push si
 mov ax,[si]
 mov bx,[si+2]
 mov cx,[si+4]
 mov dx,[si+6]
 mov di,[si+10]
 mov si,[si+8]
 call dword ptr [XMSEntry]
 pop si
 pop ds
 mov [si],ax
 mov [si+2],bx
 mov [si+4],cx
 mov [si+6],dx
 pop bp
 pop ds
End;

Procedure CallEnter;Assembler;
ASM
 call dword ptr [EnterPtr]
End;

  { Copie Count octets (pair) de Src vers le bloc XMS DstHandle:DstOfs }
Procedure XMove(Var Src;Count:Word;DstHandle:Word;DstOfs:LongInt);
Begin
 Mv.Len:=Count;
 Mv.SH:=0;
 Mv.SOff:=LongInt(Seg(Src)) shl 16+Ofs(Src);
 Mv.DH:=DstHandle;
 Mv.DOff:=DstOfs;
 XR.AX:=$0B00;
 XR.DS:=Seg(Mv);
 XR.SI:=Ofs(Mv);
 XMSCall(XR);
 If XR.AX<>1 Then Begin
  WriteLn('XMS: ',HexStr(XR.BX and $FF,2));
  Halt(2);
 End;
End;

  { Ecrit dans le bloc XMS un tableau de longueur quelconque, par morceaux }
Procedure XPut(Var Src;Len:Word;DstOfs:LongInt);
Var Done,N:Word;P:Pointer;
Begin
 Done:=0;
 While Done<Len do Begin
  N:=Len-Done;
  If N>4096 Then N:=4096;
  If N and 1<>0 Then Inc(N);
  Move(Mem[Seg(Src):Ofs(Src)+Done],ZeroBuf,N);
  XMove(ZeroBuf,N,XHandle,DstOfs+Done);
  Inc(Done,N);
 End;
End;

Procedure XZero(DstOfs,Len:LongInt);
Var N:Word;
Begin
 FillChar(ZeroBuf,SizeOf(ZeroBuf),0);
 While Len>0 do Begin
  If Len>4096 Then N:=4096 Else N:=Len;
  If N and 1<>0 Then Inc(N);
  XMove(ZeroBuf,N,XHandle,DstOfs);
  Inc(DstOfs,N);
  Dec(Len,N);
 End;
End;

Function Ptr4(S,O:Word):LongInt;Begin
 Ptr4:=LongInt(S) shl 4+O;
End;

